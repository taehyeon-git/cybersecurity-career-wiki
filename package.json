{
  "name": "cybersecurity-career-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests next.config.ts playwright.config.ts postcss.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/check-content.ts",
    "search:build": "tsx scripts/build-search.ts",
    "export:fix-rsc": "tsx scripts/fix-rsc-export.ts",
    "build:verify": "tsx scripts/verify-build.ts",
    "build": "npm run content:check && npm run search:build && next build --webpack && npm run export:fix-rsc && npm run build:verify"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
